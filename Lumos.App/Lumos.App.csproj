<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lumos — редактор RAW-фото (аналог Lightroom), інтерфейс на Avalonia: той самий код потім збереться і для Mac.
    Запуск із папки Lumos: dotnet run (параметр project = Lumos.App)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lumos.App</RootNamespace>
    <AssemblyName>Lumos</AssemblyName>
    <Version>0.1.11</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Іконка: паличка з «Люмос»-світлом у кільці діафрагми (джерело — Assets\lumos-1024.png). -->
    <ApplicationIcon>Assets\lumos.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\lumos.ico" />
    <!-- Історія версій — у вікно «Що нового» після автооновлення (Updates\Changelog.cs). -->
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="Lumos.Changelog" />
    <!-- Токен на читання релізів для автооновлення (Updates\AppUpdate.cs) — лише на ПК, у git його немає. -->
    <EmbeddedResource Include="update-token.txt" LogicalName="Lumos.UpdateToken" Condition="Exists('update-token.txt')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumos.Core\Lumos.Core.csproj" />
  </ItemGroup>

</Project>
